generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  ADMIN
}
enum KycStatus {
  NONE
  PENDING
  VERIFIED
  REJECTED
}
enum CommitteeStatus {
  FORMING
  // The 24-hour confirmation window. The roster is locked to new joiners and
  // every member can still walk away free, with no fine, no score effect and
  // no record. Nothing is owed here, which is exactly why it is safe to leave.
  CONFIRMING
  ACTIVE
  COMPLETED
  CANCELLED
}
enum CommitteeMode {
  ROTATING
  HYBRID
  INVESTMENT
}
enum CadencePreset {
  VERY_SHORT
  SHORT
  MID
  LONG
}
enum DistributionMode {
  SHARE
  COMPOUND
}
enum OrderMode {
  RANDOM_BALLOT
  HOST_ASSIGNED
  CREDIT_WEIGHTED
}
enum JoinPolicy {
  OPEN_UNTIL_FULL
  OPEN_UNTIL_DATE
  INVITE_ONLY
}
enum MemberStatus {
  ACTIVE
  EXITED
  BANNED
  REMOVED
  // Left during the 24-hour window. Deliberately distinct from EXITED: no fine,
  // no score event, and it must never be read as a default anywhere.
  WITHDRAWN
}
enum RoundStatus {
  PENDING
  COLLECTING
  INVESTED
  CLOSED
}
enum PaymentStatus {
  PENDING
  PAID
  LATE
  MISSED
}
enum DepositStatus {
  PENDING
  HELD
  REFUNDED
  FORFEITED
}
enum InvestmentStatus {
  ACTIVE
  LIQUIDATED
}
enum ListingStatus {
  OPEN
  ACCEPTED
  CANCELLED
}
enum ChangeStatus {
  PENDING
  APPROVED
  REJECTED
}
enum RiskBand {
  LOW
  MEDIUM
  HIGH
  EXTREME
}
enum RiskConsentStatus {
  PENDING
  ACCEPTED
  WITHDRAWN
}
enum HoldbackStatus {
  HELD
  RELEASED
  FORFEITED
}
enum RecoveryStatus {
  OPEN
  PAYMENT_RECORDED
  REHABILITATED
  WAIVED
}
enum CustodyMode {
  RECORDED
  BANK_CUSTODY
}
enum CommitteeTier {
  CLASSIC
  SUKOON
  BAZAAR
  PRIORITY
  SIGMA
}
enum StatementLineStatus {
  MATCHED
  UNMATCHED
  DUPLICATE
}

model User {
  id String @id @default(cuid())
  fullName String
  username String @unique
  phone String @unique
  email String @unique
  cnic String? @unique
  passwordHash String
  dataConsent Boolean @default(false)
  // Linked payment methods (wallet / Raast / bank), stored as a small JSON
  // array [{id,rail,accountNo,label,preferred}]. These are the member's OWN
  // account identifiers for receiving and auto-debit — Halqa stores pointers,
  // never balances, and never card numbers (cards only ever enter a licensed
  // aggregator's hosted page, per the no-custody rule).
  paymentMethodsJson Json?
  failedLogins Int @default(0)
  lockUntil DateTime?
  creditScore Int @default(700)
  role Role @default(MEMBER)
  kycLevel Int @default(0)
  kycStatus KycStatus @default(NONE)
  isBanned Boolean @default(false)
  banReason String?
  defaultFlag Boolean @default(false)
  cooldownUntil DateTime?
  deviceId String?
  bankVerifiedAt DateTime?
  bankVerifyRef String?
  // Salary-linked account: the member marks one linked method as the account
  // their salary lands in. Auto-collection from a salary account is the most
  // certain collection there is (Money Fellows model), so it earns a disclosed
  // 20% reduction on early/slot fees at payout.
  salaryAccountLinked Boolean @default(false)
  salaryAccountRef String?
  // Salary-day verification (2026-07-31). salaryDay = the payday the member
  // declares; salaryDayLearned = the day our own collection outcomes prove
  // (lib/salary-pattern.ts). Verification is earned, never self-asserted:
  // PAYSLIP (document), PATTERN (>=2 months of first-success-of-month within
  // tolerance), or ALERTS (on-device credit-alert summaries, aggregates only).
  // A declared day the pattern contradicts mid-cycle clears the verification,
  // costs the salary fee discount and a recorded score event.
  salaryDay Int?
  salaryDayLearned Int?
  salaryVerifiedAt DateTime?
  salaryVerifyMethod String?
  paymentAttempts PaymentAttempt[]
  salarySignals SalarySignal[]
  payslipUploads PayslipUpload[]
  // App-open PIN (4-6 digits): set at signup, asked on every open even inside a
  // valid session. Hashed (sha256+salt via lib/pin), never stored in the clear.
  pinHash String?
  // Phone ownership: a 6-digit OTP confirms the number at signup (WhatsApp rail
  // in sandbox). Real once the messaging provider connects.
  phoneVerified Boolean @default(false)
  // KYC / underwriting profile captured at signup — address, city, and what the
  // member does for a living (drives future risk models + partner KYC handoff).
  addressLine String?
  city String?
  // Broad area within the city (sector/colony, e.g. "G-13", "DHA Phase 2") —
  // shown to other members after the city as a light trust signal (never the
  // house number). jobTitle = the member's profession shown publicly (NOT the
  // employer); for a housewife it holds the husband's job.
  locality String?
  occupationType String?
  employerName String?
  jobTitle String?
  // Live home location captured at signup (device GPS). Stored as coordinates —
  // the member must set their real home; we reverse-geocode it to the address.
  homeLat Float?
  homeLng Float?
  homeLocationAt DateTime?
  // Clean committees completed. Under the seat matrix of 5 October 2026 ONE of
  // these opens every seat to a member whose bureau record cannot speak for
  // them; it does not excuse a low score resting on a real record. Turn
  // position is the collateral in the no-deposit model, so this is the field
  // that moves a member up it. The blanket quarantine on new members, and the
  // manual verification that went with it, were both withdrawn on that date;
  // earlyTurnVerifiedAt is kept only so existing rows still read.
  committeesCompletedClean Int @default(0)
  earlyTurnVerifiedAt DateTime?
  // Verification discounts on Halqa's service charges (take the largest that
  // applies): income slip + employer confirmed = 80%; a physical guarantee
  // cheque collected (enables the 489-F criminal route) = 95%. Salary link = 20%.
  incomeVerifiedAt DateTime?
  chequeSecuredAt DateTime?
  // What the member says they earn each month, in paisa, taken at signup.
  // Affordability cannot size a committee without it: with nothing on file the
  // engine has to assume zero and refuse everybody, which is what it was doing.
  // Declared, not proved — incomeVerifiedAt above is what proves it.
  declaredIncomePaisa BigInt?
  declaredIncomeAt DateTime?
  // Optional biometric unlock (WebAuthn platform authenticator) alongside the
  // app PIN. Stores the credential id only; the private key never leaves the
  // device. CNIC photo captured at signup (camera scan) — flag only for now.
  biometricCredId String?
  cnicCaptured Boolean @default(false)
  vaultParkingEnabled Boolean @default(false)
  vaultTier String @default("STANDARD")
  vaultAutoCover Boolean @default(false)
  vaultAllocation String @default("")
  // What the member is saving towards. A vault with no purpose is a number on
  // a screen; a vault with a target is a plan, and the progress bar is the
  // whole reason somebody opens the screen twice.
  vaultGoalPaisa BigInt?
  vaultGoalName String?
  supportTickets SupportTicket[]
  referredById String?
  // who brought a member in is a reference, and the member outlives it
  referredBy User? @relation("Referrals", fields:[referredById], references:[id], onDelete:SetNull)
  referrals User[] @relation("Referrals")
  paymentStreak Int @default(0)
  // Longest clean run ever achieved. paymentStreak resets on a miss; this does
  // not, so the ladder can still show what a member has already proved.
  longestStreak Int @default(0)
  // Loyalty points. Strictly separate from creditScore: points buy partner
  // discounts, score gates positions. Points never buy score and score is never
  // sold (lib/rewards.ts). Never redeemable for cash — a cash-redeemable
  // balance is a stored-value instrument and therefore regulated activity.
  rewardPoints Int @default(0)
  // Score gained from on-time payments in the current cycle, against the
  // per-cycle cap that stops the score being farmed with tiny circles.
  scoreGainedThisCycle Int @default(0)
  // --- Personalisation. A committee is a personal arrangement between people
  // who mostly know each other; an app that looks like a bank statement gets
  // opened once. None of this touches verification: displayName is what other
  // members see, fullName stays the legal name matched against the CNIC.
  avatarUrl String?
  displayName String?
  accentColor String @default("lime")
  themePref String @default("system")
  langPref String @default("en")
  textScale Int @default(100)
  highContrast Boolean @default(false)
  // Per-channel notification preferences {push,whatsapp,email,quietFrom,quietTo}.
  // A reminder that arrives at two in the morning is not a reminder, it is a
  // reason to turn notifications off entirely.
  notifyPrefsJson Json?
  rewardEvents RewardEvent[]
  exitRequests ExitRequest[] @relation("ExitRequester")
  exitVotes ExitVote[]
  averageRating Float @default(0)
  ratingCount Int @default(0)
  createdAt DateTime @default(now())
  hostedCommittees Committee[] @relation("Host")
  memberships CommitteeMember[]
  receivedRounds Round[] @relation("Recipient")
  payments Payment[]
  creditEvents CreditEvent[]
  notifications Notification[]
  chatMessages ChatMessage[]
  chatReads ChatRead[]
  sellListings ExchangeListing[] @relation("Seller")
  buyListings ExchangeListing[] @relation("Buyer")
  ledgerEntries LedgerEntry[] @relation("LedgerActor")
  kyc KycRecord?
  refreshTokens RefreshToken[]
  scheduleRequests ScheduleChangeRequest[] @relation("Requester")
  reviewedScheduleRequests ScheduleChangeRequest[] @relation("Reviewer")
  riskConsents RiskConsent[]
  bids ExchangeBid[]
  guaranteesGiven ProtectionCommitment[] @relation("Guarantor")
  recoveryCases RecoveryCase[]
  committeeWaitlists CommitteeWaitlist[]
  agreementSignatures AgreementSignature[]
  // who one member brought in
  @@index([referredById])
  idempotencyRecords IdempotencyRecord[]
}

model Committee {
  id String @id @default(cuid())
  name String
  hostId String
  host User @relation("Host", fields:[hostId], references:[id], onDelete:Restrict)
  status CommitteeStatus @default(FORMING)
  mode CommitteeMode @default(ROTATING)
  memberCap Int
  contributionPaisa BigInt
  cadencePreset CadencePreset
  periodDays Int
  reinvestRatio Float @default(0)
  schemeId String?
  scheme Scheme? @relation(fields:[schemeId], references:[id], onDelete:SetNull)
  distributionMode DistributionMode @default(SHARE)
  allowTurnCashout Boolean @default(false)
  allowTurnSale Boolean @default(true)
  // Host opted in at creation to let Halqa fill empty seats so the circle can
  // start even if not full. Halqa's seats take the FIRST turns (host's choice,
  // to minimise Halqa's own capital exposure) and carry a higher management
  // fee, both disclosed before the host confirms.
  allowHalqaFill Boolean @default(false)
  // Host-controlled discoverability: when true and the circle is FORMING with
  // open seats, it appears in the public "Discover circles" list. The host can
  // flip this on/off any time.
  listedPublicly Boolean @default(false)
  orderMode OrderMode @default(CREDIT_WEIGHTED)
  joinPolicy JoinPolicy @default(OPEN_UNTIL_FULL)
  joinDeadline DateTime?
  minMembersToStart Int
  // Set when the host presses Start. The window closes 24 hours later and the
  // circle activates. Null at every other point in the lifecycle.
  confirmingSince DateTime?
  // Group picture, the way a WhatsApp group has one. A data URI or a hosted
  // URL; the same 300KB ceiling the member avatar uses.
  avatarUrl String?
  autoStart Boolean @default(false)
  currentRound Int @default(0)
  cycleNumber Int @default(1)
  scheduleLockedAt DateTime?
  inviteCode String @unique
  createdAt DateTime @default(now())
  riskBand RiskBand @default(LOW)
  riskScore Int @default(2)
  riskTolerance Int @default(3)
  riskPolicyJson Json?
  memberConsentRequired Boolean @default(true)
  liquidityReserveBps Int @default(1000)
  payoutBufferBps Int @default(1500)
  insuranceReserveBps Int @default(0)
  latePenaltyBps Int @default(200)
  depositCoverageBps Int @default(7000)
  expectedPaymentLeadDays Int @default(0)
  custodyMode CustodyMode @default(RECORDED)
  partnerId String?
  partner PartnerBank? @relation(fields:[partnerId], references:[id], onDelete:SetNull)
  payoutGuaranteed Boolean @default(false)
  slotFeeBps Int @default(0)
  tier CommitteeTier @default(CLASSIC)
  prizeDrawEnabled Boolean @default(false)
  earlyFeeBps Int @default(0)
  dividendPooled Boolean @default(false)
  goalType String?
  goalName String?
  goalTargetPaisa BigInt?
  cleanStreak Int @default(0)
  floatSchemeId String?
  floatScheme Scheme? @relation("FloatScheme", fields:[floatSchemeId], references:[id], onDelete:SetNull)
  depositSchemeId String?
  depositScheme Scheme? @relation("DepositScheme", fields:[depositSchemeId], references:[id], onDelete:SetNull)
  statementBatches StatementBatch[]
  members CommitteeMember[]
  rounds Round[]
  ledgerEntries LedgerEntry[]
  investments Investment[]
  exchangeListings ExchangeListing[]
  chatMessages ChatMessage[]
  chatReads ChatRead[]
  creditEvents CreditEvent[]
  scheduleRequests ScheduleChangeRequest[]
  riskAssessments RiskAssessment[]
  riskConsents RiskConsent[]
  payoutHoldbacks PayoutHoldback[]
  recoveryCases RecoveryCase[]
  waitlist CommitteeWaitlist[]
  agreementSignatures AgreementSignature[]
  exitRequests ExitRequest[]
  // Gold-goal circles: the host sets the target in grams rather than rupees.
  // Contributions are still rupees; the app sizes them to the gram target at
  // the live price and settles at SPOT on payout day. Nothing is deferred, so
  // it stays clear of the bay al-sarf problem that a price lock creates.
  goldGoalGrams Float?
  // Latest computed exposure score (lib/exposure-score.ts), cached for display
  // and for the automatic band actions. Recomputed on every settlement.
  exposureScore Float @default(0)
  exposureBand String @default("SELF_FUNDING")
  exposureAt DateTime?
  // the circles one member hosts
  @@index([hostId,status])
  // discovery: open circles, newest first
  @@index([status,listedPublicly,createdAt])
}

model CommitteeWaitlist {
  id String @id @default(cuid())
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  preferredPosition Int?
  status WaitlistStatus @default(WAITING)
  createdAt DateTime @default(now())
  @@unique([committeeId,userId])
  @@index([committeeId,status])
}

model CommitteeMember {
  id String @id @default(cuid())
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Restrict)
  turnPosition Int
  hasReceived Boolean @default(false)
  status MemberStatus @default(ACTIVE)
  paidPrincipalPaisa BigInt @default(0)
  joinedAt DateTime @default(now())
  exitedAt DateTime?
  // Standing auto-debit mandate (auto-collect). The member's own consent to
  // have each due installment collected automatically on the deadline. The
  // mandate lives in the app (software consent); execution routes through the
  // provider layer — sandbox settles instantly, a live rail pulls via the
  // aggregator. Halqa never holds the money; it only schedules the pull.
  autoDebitEnabled Boolean @default(false)
  autoDebitRail String?
  autoDebitMandateAt DateTime?
  securityDeposits SecurityDeposit[]
  protectionCommitment ProtectionCommitment?
  payoutHoldbacks PayoutHoldback[]
  @@unique([committeeId,userId])
  @@unique([committeeId,turnPosition])
  // the circles one member is in, which the dashboard asks on every load
  @@index([userId,status])
  // the active roster of one circle, in turn order
  @@index([committeeId,status,turnPosition])
}

model Round {
  id String @id @default(cuid())
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  roundNumber Int
  recipientId String
  // the member a round is owed to cannot be removed while it stands
  recipient User @relation("Recipient", fields:[recipientId], references:[id], onDelete:Restrict)
  status RoundStatus @default(PENDING)
  dueDate DateTime
  payoutDate DateTime
  graceDays Int @default(5)
  grossPoolPaisa BigInt @default(0)
  reinvestPaisa BigInt @default(0)
  payoutPaisa BigInt @default(0)
  payments Payment[]
  investments Investment[]
  creditEvents CreditEvent[]
  payoutHoldback PayoutHoldback?
  recoveryCases RecoveryCase[]
  @@unique([committeeId,roundNumber])
  // the rounds of one circle in order
  @@index([committeeId,roundNumber])
  // the round that is collecting
  @@index([committeeId,status])
  // what one member has been paid
  @@index([recipientId,payoutDate])
}

model Payment {
  id String @id @default(cuid())
  roundId String
  round Round @relation(fields:[roundId], references:[id], onDelete:Cascade)
  payerId String
  payer User @relation(fields:[payerId], references:[id], onDelete:Restrict)
  amountPaisa BigInt
  dueDate DateTime
  status PaymentStatus @default(PENDING)
  paidVia String?
  txnRef String?
  paidAt DateTime?
  createdAt DateTime @default(now())
  penaltyPaisa BigInt @default(0)
  reminderLevel Int @default(0)
  recoveryCase RecoveryCase?
  @@unique([roundId,payerId])
  // one member's payments, newest first, on four different screens
  @@index([payerId,dueDate])
  // what one member owes
  @@index([payerId,status])
  // who has paid in one round
  @@index([roundId,status])
  // the collection run: everything due, oldest first
  @@index([status,dueDate])
}

model LedgerEntry {
  id String @id @default(cuid())
  committeeId String?
  committee Committee? @relation(fields:[committeeId], references:[id], onDelete:Restrict)
  actorId String?
  actor User? @relation("LedgerActor", fields:[actorId], references:[id], onDelete:SetNull)
  debit String
  credit String
  amountPaisa BigInt
  reason String
  refType String
  refId String
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  // one circle's ledger in order, which is what must balance
  @@index([committeeId,createdAt])
  // every entry about one record
  @@index([refType,refId])
}

model SecurityDeposit {
  id String @id @default(cuid())
  membershipId String
  // a deposit belongs to the membership that placed it
  membership CommitteeMember @relation(fields:[membershipId], references:[id], onDelete:Cascade)
  amountPaisa BigInt
  status DepositStatus @default(PENDING)
  txnRef String?
  confirmedAt DateTime?
  createdAt DateTime @default(now())
  releasedAt DateTime?
  accruedYieldPaisa BigInt @default(0)
  // what one member has placed
  @@index([membershipId,status])
}

model ProtectionCommitment {
  id String @id @default(cuid())
  membershipId String @unique
  membership CommitteeMember @relation(fields:[membershipId], references:[id], onDelete:Cascade)
  guarantorUserId String?
  guarantor User? @relation("Guarantor", fields:[guarantorUserId], references:[id], onDelete:Restrict)
  promissoryRef String?
  autoDebitRef String?
  acceptedTermsAt DateTime?
  verifiedByHostAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // everything one guarantor stands behind
  @@index([guarantorUserId])
}

model PayoutHoldback {
  id String @id @default(cuid())
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  membershipId String
  membership CommitteeMember @relation(fields:[membershipId], references:[id], onDelete:Cascade)
  roundId String @unique
  round Round @relation(fields:[roundId], references:[id], onDelete:Cascade)
  amountPaisa BigInt
  requiredCleanPayments Int @default(2)
  cleanPayments Int @default(0)
  status HoldbackStatus @default(HELD)
  createdAt DateTime @default(now())
  releasedAt DateTime?
  // what is held back in one circle
  @@index([committeeId,status])
  // what is held back from one member
  @@index([membershipId,status])
}

model RecoveryCase {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  roundId String
  round Round @relation(fields:[roundId], references:[id], onDelete:Cascade)
  paymentId String @unique
  payment Payment @relation(fields:[paymentId], references:[id], onDelete:Cascade)
  outstandingPaisa BigInt
  penaltyPaisa BigInt @default(0)
  status RecoveryStatus @default(OPEN)
  openedAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([userId,status])
  // the open cases in one circle
  @@index([committeeId,status])
}

model Scheme {
  id String @id @default(cuid())
  name String
  slug String @unique
  category String
  riskLevel String @default("low")
  issuer String
  tenorDays Int
  indicativeRatePct Float
  minAmountPaisa BigInt
  shariahCompliant Boolean
  isActive Boolean @default(true)
  rateAsOf DateTime
  sourceUrl String
  riskScore Int @default(2)
  liquidityDays Int @default(1)
  volatilityBps Int @default(100)
  creditRiskBps Int @default(50)
  regulatoryStatus String @default("CURATED")
  eligibilityNotes String?
  committees Committee[]
  floatCommittees Committee[] @relation("FloatScheme")
  depositCommittees Committee[] @relation("DepositScheme")
  investments Investment[]
  // the schemes on offer, by risk
  @@index([isActive,riskScore])
}

model RiskAssessment {
  id String @id @default(cuid())
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  modelVersion String
  score Int
  band RiskBand
  investmentRisk Int
  defaultRisk Int
  liquidityRisk Int
  concentrationRisk Int
  controlStrength Int
  expectedLossBps Int
  coverageRatioBps Int
  factorsJson Json
  recommendationsJson Json
  assessedAt DateTime @default(now())
  @@index([committeeId, assessedAt])
}

model RiskConsent {
  id String @id @default(cuid())
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  modelVersion String
  riskScore Int
  policyHash String
  status RiskConsentStatus @default(PENDING)
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([committeeId,userId,policyHash])
  // the consents in one circle
  @@index([committeeId,status])
}

model Investment {
  id String @id @default(cuid())
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  roundId String?
  round Round? @relation(fields:[roundId], references:[id], onDelete:Cascade)
  schemeId String
  scheme Scheme @relation(fields:[schemeId], references:[id], onDelete:Restrict)
  principalPaisa BigInt
  ratePctAtDeploy Float
  status InvestmentStatus @default(ACTIVE)
  deployedAt DateTime @default(now())
  liquidatedAt DateTime?
  realizedProfitPaisa BigInt?
  // what one round has placed
  @@index([roundId,status])
}

model ExchangeListing {
  id String @id @default(cuid())
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  sellerId String
  seller User @relation("Seller", fields:[sellerId], references:[id], onDelete:Restrict)
  position Int
  payoutPaisa BigInt
  premiumPaisa BigInt @default(0)
  buyerId String?
  buyer User? @relation("Buyer", fields:[buyerId], references:[id], onDelete:SetNull)
  status ListingStatus @default(OPEN)
  listedAt DateTime @default(now())
  acceptedAt DateTime?
  bids ExchangeBid[]
  // the open market, newest first
  @@index([status,listedAt])
  // the listings inside one circle
  @@index([committeeId,status])
  // one member's own listings
  @@index([sellerId,status])
}

model ExchangeBid {
  id String @id @default(cuid())
  listingId String
  listing ExchangeListing @relation(fields:[listingId], references:[id], onDelete:Cascade)
  bidderId String
  bidder User @relation(fields:[bidderId], references:[id], onDelete:Cascade)
  premiumPaisa BigInt
  status ListingStatus @default(OPEN)
  createdAt DateTime @default(now())
  // the open bids on one listing, highest first
  @@index([listingId,status,premiumPaisa])
  // one member's own bids
  @@index([bidderId,status])
}

model CreditEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  committeeId String?
  committee Committee? @relation(fields:[committeeId], references:[id], onDelete:SetNull)
  roundId String?
  round Round? @relation(fields:[roundId], references:[id], onDelete:SetNull)
  checkpoint String
  delta Int
  reason String
  scoredAt DateTime @default(now())
  @@unique([userId,roundId,checkpoint])
  // one member's score history, newest first
  @@index([userId,scoredAt])
}

model ChatMessage {
  id String @id @default(cuid())
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  senderId String
  sender User @relation(fields:[senderId], references:[id], onDelete:Cascade)
  body String
  pinned Boolean @default(false)
  sentAt DateTime @default(now())
  // one circle's messages in order, which is the only way they are ever read
  @@index([committeeId,sentAt])
}

model ChatRead {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  lastReadAt DateTime
  @@unique([userId,committeeId])
}

model Notification {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  type String
  message String
  isRead Boolean @default(false)
  createdAt DateTime @default(now())
  // one member's notices, newest first
  @@index([userId,createdAt])
  // the unread count, which the tab bar asks for on every screen
  @@index([userId,isRead])
}

model KycRecord {
  id String @id @default(cuid())
  userId String @unique
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  cnicNumber String
  cnicFrontUrl String
  cnicBackUrl String
  selfieUrl String
  faceMatchScore Float?
  ocrName String?
  status KycStatus @default(PENDING)
  verifiedAt DateTime?
}

model ScheduleChangeRequest {
  id String @id @default(cuid())
  committeeId String
  // a request about a circle has no meaning without it
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  requestedById String
  // the request is the member's own
  requestedBy User @relation("Requester", fields:[requestedById], references:[id], onDelete:Cascade)
  payloadJson Json
  status ChangeStatus @default(PENDING)
  reviewedById String?
  // who reviewed it is recorded; the request outlives them
  reviewedBy User? @relation("Reviewer", fields:[reviewedById], references:[id], onDelete:SetNull)
  reviewedAt DateTime?
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entityType String
  entityId String
  payloadJson Json
  at DateTime @default(now())
  // the history of one record, newest first, which is what a dispute asks for
  @@index([entityType,entityId,at])
  // everything one member did, newest first
  @@index([actorId,at])
  // every instance of one action, for a report
  @@index([action,at])
}

model PartnerBank {
  id String @id @default(cuid())
  name String
  shortCode String @unique
  custodyEnabled Boolean @default(true)
  kycEnabled Boolean @default(true)
  raastEnabled Boolean @default(true)
  sandbox Boolean @default(true)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  committees Committee[]
  statementBatches StatementBatch[]
}

model StatementBatch {
  id String @id @default(cuid())
  partnerId String
  // a bank with statements imported is not removable
  partner PartnerBank @relation(fields:[partnerId], references:[id], onDelete:Restrict)
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  importedById String
  totalLines Int
  matchedLines Int
  createdAt DateTime @default(now())
  lines StatementLine[]
}

model StatementLine {
  id String @id @default(cuid())
  batchId String
  batch StatementBatch @relation(fields:[batchId], references:[id], onDelete:Cascade)
  lineRef String
  amountPaisa BigInt
  narration String
  postedAt DateTime
  matchedPaymentId String? @unique
  status StatementLineStatus @default(UNMATCHED)
  @@index([batchId])
}

model RefreshToken {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  familyId String @default("legacy")
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([familyId])
  // the live sessions of one member, which the devices screen lists
  @@index([userId,revokedAt,expiresAt])
}

// E-signed legal instruments (ETO 2002). Two document types today:
// PLATFORM_UNDERTAKING — the master weekly-renewed undertaking every account
// signs (promissory obligation, acceleration, auto-collect + bureau consent,
// arbitration/summary-procedure consent). MUTUAL_PG — the member-to-member
// cross-guarantee recorded per committee at join, so the members (never Halqa)
// hold enforceable paper against a defaulter. Rows are append-only: each
// renewal or re-join adds a row; the newest unexpired row is the live one.
model AgreementSignature {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  committeeId String?
  committee Committee? @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  docType String
  version Int
  textHash String
  // Adopted digital signature: the member types their full legal name (must
  // match the account name) and may also draw a signature; the drawing is
  // stored as a small PNG data-URL. Together with textHash + ip + timestamp
  // this is the evidence pack for the e-signature under ETO 2002.
  signedName String?
  signatureData String?
  signedAt DateTime @default(now())
  expiresAt DateTime?
  ip String?
  @@index([userId,docType,signedAt])
  @@index([committeeId,docType])
}

// Append-only forensic trail of security-relevant events. Never updated or
// deleted in normal operation — this is the record you hand an auditor.
// One row per collection attempt against a member's instrument — the raw
// material of salary-pattern verification. We never see account inflows
// (no open banking); what we own is the outcome of our own pulls by calendar
// day, and that is enough: the day retries start succeeding IS the payday.
model PaymentAttempt {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  paymentId String?
  rail String
  calendarDay Int
  outcome String // COLLECTED | AWAITING | FAILED
  source String  // AUTO_DEBIT | MANUAL
  amountPaisa BigInt
  attemptedAt DateTime @default(now())
  @@index([userId, attemptedAt])
}

// Opt-in, on-device credit-alert summaries (notification-listener route — no
// SMS permission, no raw text ever leaves the phone). One row per month per
// source class; two consistent months verify the payday by observation.
model SalarySignal {
  id String @id @default(cuid())
  userId String
  // a salary signal is the member's own
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  dayOfMonth Int
  amountBand String   // coarse band only, e.g. "25-50k" — never the amount
  sourceClass String  // BANK | WALLET
  observedMonth String // "2026-07" — dedup + cadence key
  createdAt DateTime @default(now())
  @@unique([userId, observedMonth, sourceClass])
}

// A single payslip photo (member-downscaled JPEG). Sandbox auto-accepts,
// mirroring verify-income; production holds PENDING for review before the
// salary verification flag is granted on its strength.
model PayslipUpload {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  image Bytes
  mime String
  sha256 String
  sizeBytes Int
  status PayslipStatus @default(PENDING)
  uploadedAt DateTime @default(now())
  reviewedAt DateTime?
  @@index([userId])
  // one member's uploads, newest first
  @@index([userId,uploadedAt])
}

model SecurityEvent {
  id String @id @default(cuid())
  type String
  userId String?
  identity String?
  ip String?
  userAgent String?
  detail String?
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// --- Rewards ledger -------------------------------------------------------
// Every points movement is a row, never an in-place counter update. The
// balance on User is a cached sum; this table is the evidence behind it, so a
// member can be shown exactly why they hold what they hold.
enum RewardKind {
  PAID_ON_TIME
  PAID_EARLY
  CIRCLE_COMPLETED_CLEAN
  PAID_FOR_ANOTHER
  MISSED
}

model RewardEvent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  committeeId String?
  roundId String?
  kind RewardKind
  points Int @default(0)
  scoreDelta Int @default(0)
  streakAfter Int @default(0)
  multiplier Float @default(1)
  reason String
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}

// --- Exit ladder ----------------------------------------------------------
// There is no cancel button. Five rungs, and the arithmetic that makes a
// leaver whole without Halqa holding a pool (lib/exit-ladder.ts).
enum ExitRung {
  WINDOW
  SUBSTITUTION
  GROUP_VOTE
  HARDSHIP
  ABANDONMENT
}

enum ExitStatus {
  OPEN
  APPROVED
  DECLINED
  ESCALATED
  WITHDRAWN
  SETTLED
}

model ExitRequest {
  id String @id @default(cuid())
  committeeId String
  committee Committee @relation(fields:[committeeId], references:[id], onDelete:Cascade)
  memberId String
  userId String
  user User @relation("ExitRequester", fields:[userId], references:[id], onDelete:Cascade)
  rung ExitRung
  status ExitStatus @default(OPEN)
  reason String?
  // Voice note option: only about a third of this population reads a text
  // message, so a recorded reason must be as valid as a typed one.
  voiceNoteUrl String?
  installmentsPaid Int @default(0)
  // Restitution computed at approval and settled at cycle close. Held here so
  // the figure a member was promised is the figure they are paid.
  restitutionDuePaisa BigInt @default(0)
  finePaisa BigInt @default(0)
  fineToMembersPaisa BigInt @default(0)
  fineToPlatformPaisa BigInt @default(0)
  substituteUserId String?
  votesFor Int @default(0)
  votesAgainst Int @default(0)
  quorumMet Boolean @default(false)
  closesAt DateTime?
  decidedAt DateTime?
  settledAt DateTime?
  createdAt DateTime @default(now())
  votes ExitVote[]
  debts RestitutionDebt[]
  @@index([committeeId, status])
  // the exits in one circle, newest first
  @@index([committeeId,createdAt])
  // one member's own exits
  @@index([userId,status])
}

model ExitVote {
  id String @id @default(cuid())
  requestId String
  request ExitRequest @relation(fields:[requestId], references:[id], onDelete:Cascade)
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  approve Boolean
  createdAt DateTime @default(now())
  @@unique([requestId, userId])
}

// One row per earlier recipient who owes the leaver exactly one contribution,
// because their pot was one contribution larger than everybody's after them.
model RestitutionDebt {
  id String @id @default(cuid())
  requestId String
  request ExitRequest @relation(fields:[requestId], references:[id], onDelete:Cascade)
  debtorUserId String
  roundNumber Int
  amountPaisa BigInt
  settledAt DateTime?
  createdAt DateTime @default(now())
  @@index([requestId])
  // what one member still owes
  @@index([debtorUserId,settledAt])
}

// ---------------------------------------------------------------------------
// SUPPORT AND DISPUTES
//
// Every wallet a Pakistani member already uses has one thing Halqa did not: a
// way to say "this is wrong" and get a reference number back. Without it the
// only route is an email address on a settings page, which is not a route a
// member in trouble will take.
//
// A ticket is either a plain question or a dispute against one payment. The
// reference is what the member quotes, the same way they quote a transaction
// id, so it is short and human-readable rather than a cuid.
// ---------------------------------------------------------------------------
model SupportTicket {
  id String @id @default(cuid())
  reference String @unique
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  // QUESTION, PAYMENT, PAYOUT, ACCOUNT, CIRCLE, OTHER
  category String @default("QUESTION")
  subject String
  body String
  // OPEN, ANSWERED, RESOLVED, CLOSED
  status TicketStatus @default(OPEN)
  // Set when the ticket disputes one recorded payment.
  paymentId String?
  committeeId String?
  messages SupportMessage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
  @@index([status])
  // one member's cases, newest first
  @@index([userId,createdAt])
}

model SupportMessage {
  id String @id @default(cuid())
  ticketId String
  ticket SupportTicket @relation(fields:[ticketId], references:[id], onDelete:Cascade)
  // MEMBER or HALQA
  author String
  body String
  createdAt DateTime @default(now())
  @@index([ticketId])
}

// A waitlist entry is waiting, has been offered a seat, has taken one, or has gone away.
enum WaitlistStatus {
  WAITING
  OFFERED
  JOINED
  WITHDRAWN
}

// The three values the comment beside this column already listed, now enforced.
enum PayslipStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// A case is open, has been answered, or the member has closed it.
enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

// A request that has already been carried out, with the answer it gave.
//
// The ledger refuses a duplicate POSTING, with a unique key, so money has
// never been at risk of being moved twice. What was missing is the layer above
// it: a retried request hit that unique constraint and came back 409, so a
// client that lost the first response and retried was told its payment had
// failed when it had gone through. The member then pays again by hand.
//
// This stores what the first attempt answered, so the retry gets the same
// answer rather than a different one.
model IdempotencyRecord {
  id String @id @default(cuid())
  // The key the client sent, scoped to the member so one member cannot
  // replay or block another member's request by guessing a key.
  key String
  userId String
  user User @relation(fields:[userId], references:[id], onDelete:Cascade)
  // The route it was sent to, so the same key on a different action is a
  // different request rather than a silent replay of the wrong one.
  route String
  statusCode Int
  responseJson Json
  createdAt DateTime @default(now())
  @@unique([userId,route,key])
  // the sweep that removes records past their window
  @@index([createdAt])
}
